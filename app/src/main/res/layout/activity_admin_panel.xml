<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background">

    <include layout="@layout/view_form_topbar"/>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Welcome card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_hero_card"
                android:elevation="3dp"
                android:padding="20dp"
                android:layout_marginBottom="18dp">

                <TextView
                    android:id="@+id/tvAdminHello"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/surface"
                    android:textSize="22sp"
                    android:textStyle="bold"/>

                <TextView
                    android:id="@+id/tvAdminSummary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/teal_pale"
                    android:textSize="14sp"
                    android:layout_marginTop="4dp"/>
            </LinearLayout>

            <TextView style="@style/RegSection" android:text="OVERVIEW"/>

            <!-- Live counters -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="18dp">

                <LinearLayout
                    android:id="@+id/statPending"
                    android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:orientation="vertical" android:gravity="center_horizontal"
                    android:background="@drawable/bg_card" android:elevation="2dp"
                    android:padding="14dp" android:layout_marginEnd="8dp"
                    android:foreground="?attr/selectableItemBackground"
                    android:clickable="true" android:focusable="true">
                    <ImageView style="@style/DetailIcon.Blue" android:src="@drawable/ic_description"
                        android:layout_marginEnd="0dp"/>
                    <TextView android:id="@+id/tvStatPending"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="—" android:textColor="@color/text_primary"
                        android:textSize="26sp" android:textStyle="bold" android:layout_marginTop="8dp"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Pending claims" android:textColor="@color/text_secondary"
                        android:textSize="11sp" android:gravity="center"/>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/statAwaiting"
                    android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:orientation="vertical" android:gravity="center_horizontal"
                    android:background="@drawable/bg_card" android:elevation="2dp"
                    android:padding="14dp" android:layout_marginEnd="8dp"
                    android:foreground="?attr/selectableItemBackground"
                    android:clickable="true" android:focusable="true">
                    <ImageView style="@style/DetailIcon.Green" android:src="@drawable/ic_check_circle"
                        android:layout_marginEnd="0dp"/>
                    <TextView android:id="@+id/tvStatAwaiting"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="—" android:textColor="@color/text_primary"
                        android:textSize="26sp" android:textStyle="bold" android:layout_marginTop="8dp"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Awaiting pickup" android:textColor="@color/text_secondary"
                        android:textSize="11sp" android:gravity="center"/>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/statFinders"
                    android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:orientation="vertical" android:gravity="center_horizontal"
                    android:background="@drawable/bg_card" android:elevation="2dp"
                    android:padding="14dp"
                    android:foreground="?attr/selectableItemBackground"
                    android:clickable="true" android:focusable="true">
                    <ImageView style="@style/DetailIcon.Orange" android:src="@drawable/ic_inventory"
                        android:layout_marginEnd="0dp"/>
                    <TextView android:id="@+id/tvStatFinders"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="—" android:textColor="@color/text_primary"
                        android:textSize="26sp" android:textStyle="bold" android:layout_marginTop="8dp"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="With finders" android:textColor="@color/text_secondary"
                        android:textSize="11sp" android:gravity="center"/>
                </LinearLayout>
            </LinearLayout>

            <TextView style="@style/RegSection" android:text="INSIGHTS"/>

            <LinearLayout
                android:id="@+id/rowAnalytics"
                style="@style/RegCard"
                android:foreground="?attr/selectableItemBackground"
                android:clickable="true" android:focusable="true">
                <ImageView style="@style/DetailIcon" android:src="@drawable/ic_chart"/>
                <LinearLayout style="@style/DetailTextCol">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Analytics" android:textColor="@color/text_primary"
                        android:textSize="16sp" android:textStyle="bold"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Return rate, trends and approval ratio"
                        android:textColor="@color/text_secondary" android:textSize="12sp"
                        android:layout_marginTop="2dp"/>
                </LinearLayout>
                <ImageView android:layout_width="20dp" android:layout_height="20dp"
                    android:src="@drawable/ic_chevron_right" android:tint="@color/text_secondary"
                    android:contentDescription="@null"/>
            </LinearLayout>

            <TextView style="@style/RegSection" android:text="CLAIMS &amp; HANDOVERS" android:layout_marginTop="10dp"/>

            <LinearLayout
                android:id="@+id/rowPending"
                style="@style/RegCard"
                android:foreground="?attr/selectableItemBackground"
                android:clickable="true" android:focusable="true">
                <ImageView style="@style/DetailIcon.Blue" android:src="@drawable/ic_description"/>
                <LinearLayout style="@style/DetailTextCol">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Review pending claims" android:textColor="@color/text_primary"
                        android:textSize="16sp" android:textStyle="bold"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Approve or reject proof of ownership"
                        android:textColor="@color/text_secondary" android:textSize="12sp"
                        android:layout_marginTop="2dp"/>
                </LinearLayout>
                <TextView android:id="@+id/tvBadgePending"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:background="@drawable/bg_status_pill"
                    android:paddingHorizontal="10dp" android:paddingVertical="3dp"
                    android:textColor="@color/teal_dark" android:textSize="12sp" android:textStyle="bold"
                    android:layout_marginEnd="8dp" android:visibility="gone"/>
                <ImageView android:layout_width="20dp" android:layout_height="20dp"
                    android:src="@drawable/ic_chevron_right" android:tint="@color/text_secondary"
                    android:contentDescription="@null"/>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/rowHandovers"
                style="@style/RegCard"
                android:foreground="?attr/selectableItemBackground"
                android:clickable="true" android:focusable="true">
                <ImageView style="@style/DetailIcon.Green" android:src="@drawable/ic_check_circle"/>
                <LinearLayout style="@style/DetailTextCol">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Confirm handovers" android:textColor="@color/text_primary"
                        android:textSize="16sp" android:textStyle="bold"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Approved claims waiting for pickup"
                        android:textColor="@color/text_secondary" android:textSize="12sp"
                        android:layout_marginTop="2dp"/>
                </LinearLayout>
                <TextView android:id="@+id/tvBadgeAwaiting"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:background="@drawable/bg_status_pill"
                    android:paddingHorizontal="10dp" android:paddingVertical="3dp"
                    android:textColor="@color/teal_dark" android:textSize="12sp" android:textStyle="bold"
                    android:layout_marginEnd="8dp" android:visibility="gone"/>
                <ImageView android:layout_width="20dp" android:layout_height="20dp"
                    android:src="@drawable/ic_chevron_right" android:tint="@color/text_secondary"
                    android:contentDescription="@null"/>
            </LinearLayout>

            <TextView style="@style/RegSection" android:text="ITEMS &amp; PEOPLE" android:layout_marginTop="10dp"/>

            <LinearLayout
                android:id="@+id/rowFinderHeld"
                style="@style/RegCard"
                android:foreground="?attr/selectableItemBackground"
                android:clickable="true" android:focusable="true">
                <ImageView style="@style/DetailIcon.Orange" android:src="@drawable/ic_inventory"/>
                <LinearLayout style="@style/DetailTextCol">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Items held by finders" android:textColor="@color/text_primary"
                        android:textSize="16sp" android:textStyle="bold"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Follow up on items not yet turned in"
                        android:textColor="@color/text_secondary" android:textSize="12sp"
                        android:layout_marginTop="2dp"/>
                </LinearLayout>
                <TextView android:id="@+id/tvBadgeFinders"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:background="@drawable/bg_status_pill"
                    android:paddingHorizontal="10dp" android:paddingVertical="3dp"
                    android:textColor="@color/teal_dark" android:textSize="12sp" android:textStyle="bold"
                    android:layout_marginEnd="8dp" android:visibility="gone"/>
                <ImageView android:layout_width="20dp" android:layout_height="20dp"
                    android:src="@drawable/ic_chevron_right" android:tint="@color/text_secondary"
                    android:contentDescription="@null"/>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/rowUsers"
                style="@style/RegCard"
                android:foreground="?attr/selectableItemBackground"
                android:clickable="true" android:focusable="true">
                <ImageView style="@style/DetailIcon.Red" android:src="@drawable/ic_group"/>
                <LinearLayout style="@style/DetailTextCol">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Manage users" android:textColor="@color/text_primary"
                        android:textSize="16sp" android:textStyle="bold"/>
                    <TextView android:id="@+id/tvUsersSubtitle"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Promote or remove admin access"
                        android:textColor="@color/text_secondary" android:textSize="12sp"
                        android:layout_marginTop="2dp"/>
                </LinearLayout>
                <ImageView android:layout_width="20dp" android:layout_height="20dp"
                    android:src="@drawable/ic_chevron_right" android:tint="@color/text_secondary"
                    android:contentDescription="@null"/>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</LinearLayout>
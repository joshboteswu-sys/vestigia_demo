<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="USER PROFILE"
            android:textSize="20sp"
            android:textStyle="bold"
            android:letterSpacing="0.04"
            android:textColor="@color/text_primary"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="16dp"/>

        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:indeterminateTint="@color/teal_dark"/>

        <!-- Profile header card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:background="@drawable/bg_card"
            android:backgroundTint="@color/teal_dark"
            android:padding="20dp"
            android:layout_marginBottom="16dp">

            <ImageView
                android:id="@+id/ivPhoto"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:scaleType="centerCrop"
                android:background="@android:color/transparent"
                android:contentDescription="Profile photo"
                android:src="@android:drawable/ic_menu_gallery"
                android:layout_marginBottom="12dp"/>

            <TextView
                android:id="@+id/tvName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/surface"/>

            <TextView
                android:id="@+id/tvEmail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textColor="@color/teal_pale"
                android:textSize="12sp"
                android:layout_marginTop="4dp"/>

            <TextView
                android:id="@+id/tvContact"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textColor="@color/teal_pale"
                android:textSize="12sp"
                android:layout_marginTop="2dp"/>
        </LinearLayout>

        <!-- Stat cards -->
        <!-- Stat cards -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="24dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="90dp"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/bg_card"
                android:padding="8dp"
                android:layout_marginEnd="8dp">
                <TextView
                    android:id="@+id/tvLostCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"/>
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Lost Reported"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp"
                    android:gravity="center"
                    android:layout_marginTop="2dp"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="90dp"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/bg_card"
                android:padding="8dp"
                android:layout_marginEnd="8dp">
                <TextView
                    android:id="@+id/tvFoundCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"/>
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Found Turned In"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp"
                    android:gravity="center"
                    android:layout_marginTop="2dp"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="90dp"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/bg_card"
                android:padding="8dp">
                <TextView
                    android:id="@+id/tvClaimedCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"/>
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Claimed"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp"
                    android:gravity="center"
                    android:layout_marginTop="2dp"/>
            </LinearLayout>
        </LinearLayout>

        <!-- My lost reports -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="My Lost Reports"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:id="@+id/tvEmptyLost"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="No lost reports yet."
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:padding="8dp"
            android:visibility="gone"/>

        <LinearLayout
            android:id="@+id/containerLostReports"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="20dp"/>

        <!-- Items turned in (found) -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Items I Turned In (Found)"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:id="@+id/tvEmptyFound"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="No found items reported yet."
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:padding="8dp"
            android:visibility="gone"/>

        <LinearLayout
            android:id="@+id/containerFoundReports"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="20dp"/>

        <!-- Items claimed -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Items I Claimed"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:id="@+id/tvEmptyClaims"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="No claims yet."
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:padding="8dp"
            android:visibility="gone"/>

        <LinearLayout
            android:id="@+id/containerClaims"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="20dp"/>

    </LinearLayout>
</ScrollView>
<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background">

    <!-- Top bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/teal_dark"
        android:paddingHorizontal="16dp">

        <ImageView
            android:id="@+id/ivBack"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/ic_arrow_back"
            app:tint="@color/surface"
            android:contentDescription="Back"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Register"
            android:textColor="@color/surface"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginStart="24dp"/>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Profile photo -->
            <FrameLayout
                android:id="@+id/photoContainer"
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="12dp">

                <ImageView
                    android:id="@+id/ivPhoto"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_circle_teal"
                    android:src="@drawable/ic_person_placeholder"
                    android:padding="26dp"
                    android:scaleType="centerCrop"
                    android:contentDescription="Profile photo"/>

                <ImageView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_gravity="bottom|end"
                    android:background="@drawable/bg_camera_badge"
                    android:src="@drawable/ic_camera"
                    app:tint="@color/surface"
                    android:padding="8dp"
                    android:contentDescription="@null"/>
            </FrameLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Add a profile photo (optional)"
                android:textColor="@color/text_secondary"
                android:textSize="14sp"
                android:gravity="center"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="24dp"/>

            <!-- PERSONAL INFO -->
            <TextView style="@style/RegSection" android:text="PERSONAL INFO"/>

            <LinearLayout style="@style/RegCard">
                <ImageView style="@style/RegIconTile" android:src="@drawable/ic_person" android:contentDescription="@null"/>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical">
                    <TextView style="@style/RegLabel" android:text="First Name"/>
                    <EditText android:id="@+id/etFirstName" style="@style/RegInput"
                        android:hint="Enter first name"
                        android:inputType="textPersonName|textCapWords"/>
                </LinearLayout>
            </LinearLayout>

            <LinearLayout style="@style/RegCard">
                <ImageView style="@style/RegIconTile" android:src="@drawable/ic_person" android:contentDescription="@null"/>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical">
                    <TextView style="@style/RegLabel" android:text="Last Name"/>
                    <EditText android:id="@+id/etLastName" style="@style/RegInput"
                        android:hint="Enter last name"
                        android:inputType="textPersonName|textCapWords"/>
                </LinearLayout>
            </LinearLayout>

            <!-- Student ID: auto-formats to 00-0000-000000 -->
            <LinearLayout style="@style/RegCard">
                <ImageView style="@style/RegIconTile" android:src="@drawable/ic_id_card" android:contentDescription="@null"/>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical">
                    <TextView style="@style/RegLabel" android:text="Student ID"/>
                    <EditText android:id="@+id/etStudentId" style="@style/RegInput"
                        android:hint="00-0000-000000"
                        android:inputType="number"
                        android:digits="0123456789-"
                        android:maxLength="14"/>
                </LinearLayout>
            </LinearLayout>

            <LinearLayout style="@style/RegCard">
                <ImageView style="@style/RegIconTile" android:src="@drawable/ic_email" android:contentDescription="@null"/>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical">
                    <TextView style="@style/RegLabel" android:text="Email"/>
                    <EditText android:id="@+id/etEmail" style="@style/RegInput"
                        android:hint="your@email.com"
                        android:inputType="textEmailAddress"/>
                </LinearLayout>
            </LinearLayout>

            <!-- Phone with fixed +63 prefix -->
            <LinearLayout style="@style/RegCard">
                <ImageView style="@style/RegIconTile" android:src="@drawable/ic_phone" android:contentDescription="@null"/>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical">
                    <TextView style="@style/RegLabel" android:text="Phone"/>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="&#x1F1F5;&#x1F1ED;  +63"
                            android:textColor="@color/text_primary"
                            android:textSize="16sp"
                            android:layout_marginEnd="10dp"/>
                        <EditText android:id="@+id/etPhone" style="@style/RegInput"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:hint="9XX XXX XXXX"
                            android:inputType="number"
                            android:maxLength="11"/>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- Preferred contact -->
            <LinearLayout style="@style/RegCard">
                <ImageView style="@style/RegIconTile" android:src="@drawable/ic_chat" android:contentDescription="@null"/>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical">
                    <TextView style="@style/RegLabel" android:text="Preferred Contact"/>
                    <RadioGroup
                        android:id="@+id/rgPreferredContact"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">
                        <RadioButton
                            android:id="@+id/rbEmail"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Email"
                            android:textSize="14sp"
                            android:textColor="@color/text_primary"
                            android:buttonTint="@color/teal_dark"
                            android:checked="true"
                            android:layout_marginEnd="8dp"/>
                        <RadioButton
                            android:id="@+id/rbSms"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="SMS"
                            android:textSize="14sp"
                            android:textColor="@color/text_primary"
                            android:buttonTint="@color/teal_dark"
                            android:layout_marginEnd="8dp"/>
                        <RadioButton
                            android:id="@+id/rbPush"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Push"
                            android:textSize="14sp"
                            android:textColor="@color/text_primary"
                            android:buttonTint="@color/teal_dark"/>
                    </RadioGroup>
                </LinearLayout>
            </LinearLayout>

            <!-- SECURITY -->
            <TextView style="@style/RegSection" android:text="SECURITY" android:layout_marginTop="12dp"/>

            <LinearLayout style="@style/RegCard">
                <ImageView style="@style/RegIconTile" android:src="@drawable/ic_lock" android:contentDescription="@null"/>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical">
                    <TextView style="@style/RegLabel" android:text="Password"/>
                    <EditText android:id="@+id/etPassword" style="@style/RegInput"
                        android:hint="Create a password"
                        android:inputType="textPassword"/>
                </LinearLayout>
                <ImageView
                    android:id="@+id/ivTogglePassword"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:padding="4dp"
                    android:src="@drawable/ic_visibility"
                    app:tint="@color/text_secondary"
                    android:contentDescription="Show or hide password"/>
            </LinearLayout>

            <LinearLayout style="@style/RegCard">
                <ImageView style="@style/RegIconTile" android:src="@drawable/ic_shield" android:contentDescription="@null"/>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical">
                    <TextView style="@style/RegLabel" android:text="Confirm Password"/>
                    <EditText android:id="@+id/etConfirmPassword" style="@style/RegInput"
                        android:hint="Repeat your password"
                        android:inputType="textPassword"/>
                </LinearLayout>
                <ImageView
                    android:id="@+id/ivToggleConfirm"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:padding="4dp"
                    android:src="@drawable/ic_visibility"
                    app:tint="@color/text_secondary"
                    android:contentDescription="Show or hide password"/>
            </LinearLayout>

            <TextView
                android:id="@+id/tvError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/error_text"
                android:textSize="13sp"
                android:visibility="gone"
                android:layout_marginBottom="8dp"/>

            <ProgressBar
                android:id="@+id/progressBar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:indeterminateTint="@color/teal_dark"
                android:visibility="gone"
                android:layout_marginBottom="8dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRegister"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:text="Create Account"
                android:textAllCaps="false"
                android:textSize="17sp"
                android:textStyle="bold"
                app:icon="@drawable/ic_person_add"
                app:iconGravity="textStart"
                app:cornerRadius="16dp"
                app:backgroundTint="@color/teal_dark"
                android:layout_marginTop="8dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="24dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Already have an account? "
                    android:textColor="@color/text_secondary"
                    android:textSize="15sp"/>

                <TextView
                    android:id="@+id/tvSignIn"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Sign In"
                    android:textColor="@color/teal_dark"
                    android:textStyle="bold"
                    android:textSize="15sp"/>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</LinearLayout>
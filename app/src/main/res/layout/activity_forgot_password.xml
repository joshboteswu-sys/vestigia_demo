<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background">

    <include layout="@layout/view_form_topbar"/>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/tvIntro"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/text_secondary"
                android:textSize="14sp"
                android:lineSpacingExtra="3dp"
                android:layout_marginBottom="16dp"/>

            <!-- Step 1: who are you? -->
            <LinearLayout
                android:id="@+id/stepRequest"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView style="@style/RegSection" android:text="ACCOUNT"/>

                <LinearLayout style="@style/RegCard">
                    <ImageView style="@style/RegIconTile" android:src="@drawable/ic_email" android:contentDescription="@null"/>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical">
                        <TextView style="@style/RegLabel" android:text="Email or Student ID"/>
                        <EditText android:id="@+id/etIdentifier" style="@style/RegInput"
                            android:hint="you@email.com or 00-0000-000000"
                            android:inputType="textEmailAddress"/>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- Step 2: code + new password -->
            <LinearLayout
                android:id="@+id/stepReset"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tvSentInfo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/teal_dark"
                    android:textSize="13sp"
                    android:layout_marginBottom="12dp"/>

                <TextView style="@style/RegSection" android:text="RESET CODE"/>

                <LinearLayout style="@style/RegCard">
                    <ImageView style="@style/RegIconTile" android:src="@drawable/ic_shield" android:contentDescription="@null"/>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical">
                        <TextView style="@style/RegLabel" android:text="6-digit code"/>
                        <EditText android:id="@+id/etCode" style="@style/RegInput"
                            android:hint="000000"
                            android:inputType="number"
                            android:maxLength="6"/>
                    </LinearLayout>
                </LinearLayout>

                <TextView style="@style/RegSection" android:text="NEW PASSWORD" android:layout_marginTop="8dp"/>

                <LinearLayout style="@style/RegCard">
                    <ImageView style="@style/RegIconTile" android:src="@drawable/ic_lock" android:contentDescription="@null"/>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical">
                        <TextView style="@style/RegLabel" android:text="New password"/>
                        <EditText android:id="@+id/etNewPassword" style="@style/RegInput"
                            android:hint="At least 6 characters"
                            android:inputType="textPassword"/>
                    </LinearLayout>
                    <ImageView
                        android:id="@+id/ivToggleNew"
                        android:layout_width="32dp" android:layout_height="32dp" android:padding="4dp"
                        android:src="@drawable/ic_visibility_off" android:tint="@color/text_secondary"
                        android:contentDescription="Show or hide password"/>
                </LinearLayout>

                <LinearLayout style="@style/RegCard">
                    <ImageView style="@style/RegIconTile" android:src="@drawable/ic_shield" android:contentDescription="@null"/>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical">
                        <TextView style="@style/RegLabel" android:text="Confirm new password"/>
                        <EditText android:id="@+id/etConfirmPassword" style="@style/RegInput"
                            android:hint="Repeat the new password"
                            android:inputType="textPassword"/>
                    </LinearLayout>
                    <ImageView
                        android:id="@+id/ivToggleConfirm"
                        android:layout_width="32dp" android:layout_height="32dp" android:padding="4dp"
                        android:src="@drawable/ic_visibility_off" android:tint="@color/text_secondary"
                        android:contentDescription="Show or hide password"/>
                </LinearLayout>

                <TextView
                    android:id="@+id/tvResend"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:text="Resend code"
                    android:textColor="@color/teal_dark"
                    android:textStyle="bold"
                    android:textSize="15sp"
                    android:padding="12dp"/>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- Bottom bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/surface"
        android:elevation="8dp"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp">

        <TextView
            android:id="@+id/tvError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/error_text"
            android:textSize="13sp"
            android:visibility="gone"
            android:layout_marginBottom="8dp"/>

        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:indeterminateTint="@color/teal_dark"
            android:visibility="gone"
            android:layout_marginBottom="8dp"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPrimary"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:textAllCaps="false"
            android:textSize="17sp"
            android:textStyle="bold"
            app:icon="@drawable/ic_check_circle"
            app:iconGravity="textStart"
            app:iconTint="@color/surface"
            app:cornerRadius="16dp"
            app:backgroundTint="@color/teal_dark"/>
    </LinearLayout>

</LinearLayout>
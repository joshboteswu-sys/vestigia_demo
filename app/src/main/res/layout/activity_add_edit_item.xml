<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background">

    <include layout="@layout/view_form_topbar"/>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView style="@style/RegSection" android:text="PHOTO"/>

            <FrameLayout
                android:id="@+id/photoSlot"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card"
                android:elevation="2dp"
                android:padding="14dp"
                android:layout_marginBottom="16dp"
                android:clickable="true"
                android:focusable="true">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="170dp"
                    android:background="@drawable/bg_dashed_slot"
                    android:clipToOutline="true">

                    <ImageView
                        android:id="@+id/ivPhoto"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:visibility="gone"
                        android:contentDescription="Item photo"/>

                    <LinearLayout
                        android:id="@+id/photoPlaceholder"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:orientation="vertical"
                        android:gravity="center_horizontal">
                        <ImageView
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:src="@drawable/ic_camera"
                            android:tint="@color/text_secondary"
                            android:contentDescription="@null"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Add photo"
                            android:textColor="@color/text_secondary"
                            android:textSize="14sp"
                            android:layout_marginTop="6dp"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Tap to choose from your gallery"
                            android:textColor="#A0AEC0"
                            android:textSize="11sp"/>
                    </LinearLayout>
                </FrameLayout>
            </FrameLayout>

            <TextView style="@style/RegSection" android:text="DETAILS"/>

            <LinearLayout style="@style/RegCard">
                <ImageView style="@style/RegIconTile" android:src="@drawable/ic_edit" android:contentDescription="@null"/>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical">
                    <TextView style="@style/RegLabel" android:text="Item name"/>
                    <EditText android:id="@+id/etItemName" style="@style/RegInput"
                        android:hint="e.g. Blue umbrella"
                        android:inputType="textCapWords"/>
                </LinearLayout>
            </LinearLayout>

            <LinearLayout style="@style/RegCard">
                <ImageView style="@style/RegIconTile" android:src="@drawable/ic_tag" android:contentDescription="@null"/>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical">
                    <TextView style="@style/RegLabel" android:text="Category"/>
                    <EditText android:id="@+id/etCategory" style="@style/RegInput"
                        android:hint="e.g. Electronics"
                        android:inputType="textCapWords"/>
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/rowDate"
                style="@style/RegCard"
                android:clickable="true"
                android:focusable="true">
                <ImageView style="@style/RegIconTile" android:src="@drawable/ic_calendar" android:contentDescription="@null"/>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical">
                    <TextView style="@style/RegLabel" android:text="Date found"/>
                    <TextView
                        android:id="@+id/tvDate"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Select a date"
                        android:textColorHint="#A0AEC0"
                        android:textColor="@color/text_primary"
                        android:textSize="16sp"
                        android:paddingTop="2dp"
                        android:paddingBottom="2dp"/>
                </LinearLayout>
                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_chevron_right"
                    android:tint="@color/text_secondary"
                    android:contentDescription="@null"/>
            </LinearLayout>

            <LinearLayout style="@style/RegCard">
                <ImageView style="@style/RegIconTile" android:src="@drawable/ic_location" android:contentDescription="@null"/>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical">
                    <TextView style="@style/RegLabel" android:text="Found location"/>
                    <EditText android:id="@+id/etLocation" style="@style/RegInput"
                        android:hint="e.g. Library, 2nd floor"
                        android:inputType="textCapSentences"/>
                </LinearLayout>
            </LinearLayout>

            <LinearLayout style="@style/RegCard">
                <ImageView style="@style/RegIconTile" android:src="@drawable/ic_description" android:contentDescription="@null"/>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical">
                    <TextView style="@style/RegLabel" android:text="Description"/>
                    <EditText android:id="@+id/etDescription" style="@style/RegInput"
                        android:hint="Marks, colour, contents…"
                        android:inputType="textMultiLine|textCapSentences"
                        android:minLines="3"
                        android:maxLines="8"
                        android:gravity="top"/>
                </LinearLayout>
            </LinearLayout>

            <!-- Custody (only when reporting a new item) -->
            <LinearLayout
                android:id="@+id/custodySection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView style="@style/RegSection" android:text="CUSTODY" android:layout_marginTop="12dp"/>

                <LinearLayout style="@style/RegCard">
                    <ImageView style="@style/RegIconTile" android:src="@drawable/ic_inventory" android:contentDescription="@null"/>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical">
                        <TextView style="@style/RegLabel" android:text="Where is the item now?"/>
                        <RadioGroup
                            android:id="@+id/rgCustody"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">
                            <RadioButton
                                android:id="@+id/rbWithMe"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="I'm still holding it"
                                android:textSize="14sp"
                                android:textColor="@color/text_primary"
                                android:buttonTint="@color/teal_dark"
                                android:checked="true"/>
                            <RadioButton
                                android:id="@+id/rbAdminOffice"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="I already turned it in to the Admin Office"
                                android:textSize="14sp"
                                android:textColor="@color/text_primary"
                                android:buttonTint="@color/teal_dark"/>
                        </RadioGroup>
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout style="@style/RegCard">
                    <ImageView style="@style/RegIconTile" android:src="@drawable/ic_location" android:contentDescription="@null"/>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical">
                        <TextView style="@style/RegLabel" android:text="Pick-up note (optional)"/>
                        <EditText android:id="@+id/etCustodyNote" style="@style/RegInput"
                            android:hint="Where can the owner collect it?"
                            android:inputType="textCapSentences"/>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- Bottom bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/surface"
        android:elevation="8dp"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp">

        <TextView
            android:id="@+id/tvError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/error_text"
            android:textSize="13sp"
            android:visibility="gone"
            android:layout_marginBottom="8dp"/>

        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:indeterminateTint="@color/teal_dark"
            android:visibility="gone"
            android:layout_marginBottom="8dp"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSave"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Submit"
            android:textAllCaps="false"
            android:textSize="17sp"
            android:textStyle="bold"
            app:icon="@drawable/ic_check_circle"
            app:iconGravity="textStart"
            app:iconTint="@color/surface"
            app:cornerRadius="16dp"
            app:backgroundTint="@color/teal_dark"/>
    </LinearLayout>

</LinearLayout>
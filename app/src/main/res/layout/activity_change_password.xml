<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background">

    <include layout="@layout/view_form_topbar"/>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView style="@style/RegSection" android:text="SECURITY"/>

            <LinearLayout style="@style/RegCard">
                <ImageView style="@style/RegIconTile" android:src="@drawable/ic_lock" android:contentDescription="@null"/>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical">
                    <TextView style="@style/RegLabel" android:text="Current password"/>
                    <EditText android:id="@+id/etCurrentPassword" style="@style/RegInput"
                        android:hint="Enter your current password"
                        android:inputType="textPassword"/>
                </LinearLayout>
                <ImageView
                    android:id="@+id/ivToggleCurrent"
                    android:layout_width="32dp" android:layout_height="32dp" android:padding="4dp"
                    android:src="@drawable/ic_visibility_off"
                    android:tint="@color/text_secondary"
                    android:contentDescription="Show or hide password"/>
            </LinearLayout>

            <LinearLayout style="@style/RegCard">
                <ImageView style="@style/RegIconTile" android:src="@drawable/ic_lock" android:contentDescription="@null"/>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical">
                    <TextView style="@style/RegLabel" android:text="New password"/>
                    <EditText android:id="@+id/etNewPassword" style="@style/RegInput"
                        android:hint="At least 6 characters"
                        android:inputType="textPassword"/>
                </LinearLayout>
                <ImageView
                    android:id="@+id/ivToggleNew"
                    android:layout_width="32dp" android:layout_height="32dp" android:padding="4dp"
                    android:src="@drawable/ic_visibility_off"
                    android:tint="@color/text_secondary"
                    android:contentDescription="Show or hide password"/>
            </LinearLayout>

            <LinearLayout style="@style/RegCard">
                <ImageView style="@style/RegIconTile" android:src="@drawable/ic_shield" android:contentDescription="@null"/>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical">
                    <TextView style="@style/RegLabel" android:text="Confirm new password"/>
                    <EditText android:id="@+id/etConfirmNewPassword" style="@style/RegInput"
                        android:hint="Repeat the new password"
                        android:inputType="textPassword"/>
                </LinearLayout>
                <ImageView
                    android:id="@+id/ivToggleConfirm"
                    android:layout_width="32dp" android:layout_height="32dp" android:padding="4dp"
                    android:src="@drawable/ic_visibility_off"
                    android:tint="@color/text_secondary"
                    android:contentDescription="Show or hide password"/>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- Bottom bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/surface"
        android:elevation="8dp"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp">

        <TextView
            android:id="@+id/tvError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/error_text"
            android:textSize="13sp"
            android:visibility="gone"
            android:layout_marginBottom="8dp"/>

        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:indeterminateTint="@color/teal_dark"
            android:visibility="gone"
            android:layout_marginBottom="8dp"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSave"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Update password"
            android:textAllCaps="false"
            android:textSize="17sp"
            android:textStyle="bold"
            app:icon="@drawable/ic_check_circle"
            app:iconGravity="textStart"
            app:iconTint="@color/surface"
            app:cornerRadius="16dp"
            app:backgroundTint="@color/teal_dark"/>
    </LinearLayout>

</LinearLayout>
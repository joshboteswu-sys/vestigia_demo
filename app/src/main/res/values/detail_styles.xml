<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="DetailCard">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">vertical</item>
        <item name="android:background">@drawable/bg_card</item>
        <item name="android:elevation">2dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:paddingTop">16dp</item>
        <item name="android:paddingBottom">6dp</item>
        <item name="android:layout_marginStart">16dp</item>
        <item name="android:layout_marginEnd">16dp</item>
        <item name="android:layout_marginTop">14dp</item>
    </style>

    <style name="DetailSection">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.12</item>
        <item name="android:layout_marginBottom">6dp</item>
    </style>

    <style name="DetailRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
    </style>

    <style name="DetailIcon">
        <item name="android:layout_width">44dp</item>
        <item name="android:layout_height">44dp</item>
        <item name="android:padding">11dp</item>
        <item name="android:background">@drawable/bg_icon_tile</item>
        <item name="android:tint">@color/teal_dark</item>
        <item name="android:layout_marginEnd">14dp</item>
        <item name="android:contentDescription">@null</item>
    </style>
    <style name="DetailIcon.Blue">
        <item name="android:background">@drawable/bg_icon_tile_blue</item>
        <item name="android:tint">#2563EB</item>
    </style>
    <style name="DetailIcon.Green">
        <item name="android:background">@drawable/bg_icon_tile_green</item>
        <item name="android:tint">#16A34A</item>
    </style>
    <style name="DetailIcon.Orange">
        <item name="android:background">@drawable/bg_icon_tile_orange</item>
        <item name="android:tint">#EA580C</item>
    </style>
    <style name="DetailIcon.Red">
        <item name="android:background">@drawable/bg_icon_tile_red</item>
        <item name="android:tint">#DC2626</item>
    </style>

    <style name="DetailTextCol">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:orientation">vertical</item>
    </style>

    <style name="DetailLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">11sp</item>
        <item name="android:letterSpacing">0.1</item>
    </style>

    <style name="DetailValue">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">16sp</item>
        <item name="android:lineSpacingExtra">3dp</item>
        <item name="android:layout_marginTop">2dp</item>
    </style>

    <style name="DetailDivider">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:background">#EEF2F2</item>
        <item name="android:layout_marginStart">58dp</item>
    </style>

</resources>
<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:label="Vestigia"
        android:networkSecurityConfig="@xml/network_security_config"
        android:usesCleartextTraffic="true"
        android:supportsRtl="true"
        android:theme="@style/Theme.AppCompat.Light.NoActionBar">

        <activity android:name=".auth.LoginActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".auth.RegisterActivity" android:exported="false" />
        <activity android:name=".items.DashboardActivity" android:exported="false" />
        <activity android:name=".items.FoundItemsListActivity" android:exported="false" />
        <activity android:name=".items.AddEditItemActivity" android:exported="false" />
        <activity android:name=".items.ItemDetailActivity" android:exported="false" />

    </application>
</manifest>